+const IDLE_EXIT_VARIABLE: &str = "GAZED_IDLE_EXIT_SECONDS";
+const IDLE_CHECK_INTERVAL: std::time::Duration = std::time::Duration::from_secs(5);
+
+/// How long gazed may sit idle before exiting, from GAZED_IDLE_EXIT_SECONDS: 0 exits as soon as it
+/// is idle; unset keeps it running.
+fn idle_exit_after() -> Option<std::time::Duration> {
+    let seconds: u64 = std::env::var(IDLE_EXIT_VARIABLE).ok()?.parse().ok()?;
+    Some(std::time::Duration::from_secs(seconds))
+}
+
+/// Returns once nothing has been claimed, held the camera or run a benchmark for `limit`.
+async fn wait_until_idle(
+    limit: Option<std::time::Duration>,
+    claim_state: daemon::ClaimStateHandle,
+    camera_lease: daemon::CameraLease,
+    benchmark_running: Arc<std::sync::atomic::AtomicBool>,
+) {
+    let Some(limit) = limit else {
+        return std::future::pending().await;
+    };
+    let mut idle_since = std::time::Instant::now();
+    loop {
+        tokio::time::sleep(IDLE_CHECK_INTERVAL).await;
+        let claimed = claim_state.try_lock().map_or(true, |claim| claim.is_some());
+        let camera_in_use = camera_lease.try_lock().is_err();
+        let benchmarking = benchmark_running.load(std::sync::atomic::Ordering::Relaxed);
+        if claimed || camera_in_use || benchmarking {
+            idle_since = std::time::Instant::now();
+        } else if idle_since.elapsed() >= limit {
+            return;
+        }
+    }
+}
