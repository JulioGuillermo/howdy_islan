+
+/// The detector works on the frame padded to a square, so its box is shifted back by the padding.
+fn face_box_fractions(frame: &Mat, (x1, y1, x2, y2): (f32, f32, f32, f32)) -> [f32; 4] {
+    let width = frame.cols().max(1) as f32;
+    let height = frame.rows().max(1) as f32;
+    let side = width.max(height);
+    let left = ((side - width) / 2.0).floor();
+    let top = ((side - height) / 2.0).floor();
+    let x = ((x1 - left) / width).clamp(0.0, 1.0);
+    let y = ((y1 - top) / height).clamp(0.0, 1.0);
+    let right = ((x2 - left) / width).clamp(0.0, 1.0);
+    let bottom = ((y2 - top) / height).clamp(0.0, 1.0);
+    [x, y, right - x, bottom - y]
 }
 
