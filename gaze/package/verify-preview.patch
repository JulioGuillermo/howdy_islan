+    /// The face found in the last frame, as fractions of the frame: x, y, width and height of its
+    /// box, then x and y of each of its five landmarks (eyes, nose tip, mouth corners) when found.
+    pub fn last_face(&self) -> Option<&[f32]> {
+        self.last_face.as_deref()
+    }
+}
+
+/// The detector works on the frame padded to a square, so its points are shifted back by the padding.
+fn face_fractions(
+    frame: &Mat,
+    (x1, y1, x2, y2): (f32, f32, f32, f32),
+    landmarks: Option<&ndarray::Array3<f32>>,
+) -> Vec<f32> {
+    let width = frame.cols().max(1) as f32;
+    let height = frame.rows().max(1) as f32;
+    let side = width.max(height);
+    let left = ((side - width) / 2.0).floor();
+    let top = ((side - height) / 2.0).floor();
+    let fraction = |x: f32, y: f32| {
+        (
+            ((x - left) / width).clamp(0.0, 1.0),
+            ((y - top) / height).clamp(0.0, 1.0),
+        )
+    };
+
+    let (x, y) = fraction(x1, y1);
+    let (right, bottom) = fraction(x2, y2);
+    let mut face = vec![x, y, right - x, bottom - y];
+    if let Some(landmarks) = landmarks.filter(|marks| marks.shape()[0] > 0 && marks.shape()[1] >= 5) {
+        for point in 0..5 {
+            let (x, y) = fraction(landmarks[[0, point, 0]], landmarks[[0, point, 1]]);
+            face.extend([x, y]);
+        }
+    }
+    face
 }
 
