#!/usr/bin/env bash
# Installs Gaze (face unlock with a liveness check) and adds it to PAM after the password prompt:
# type the password as usual, or press Enter on an empty prompt to use the face. Asks where the
# face models run (the processor, or an Intel NPU when there is one) and whether gazed stays
# running or starts only when needed.
#
#   ./install_gaze              build and install Gaze, configure it, patch PAM
#   ./install_gaze --enrol      enrol your face, unless one is already there
#   ./install_gaze --uninstall  remove the PAM lines, the gaze package and the NPU runtime
#   ./install_gaze --installed  exit 0 when Gaze is installed
#
# The package is gaze-island (package/): Gaze's own, with gazed rebuilt so it also sends the IR
# frames while scanning and can exit when idle.
#
# PAM_SERVICES overrides which files under /etc/pam.d get the lines.

set -euo pipefail

HERE=$(dirname "$(realpath "$0")")
source "$HERE/../lib.sh"

GAZE_CONFIG=/etc/gaze/config.toml
GAZE_PACKAGES="gaze-island gaze-bin gaze"
PAM_OPTOUT=/etc/gaze/pam.optout
PAM_LINES="-auth      requisite    pam_faillock.so preauth
auth       sufficient   pam_unix.so try_first_pass likeauth
auth       sufficient   pam_gaze.so"
# pam_gaze only talks to a gazed already running, so on demand PAM starts it, and waits for it,
# once the password was left empty or wrong: a right password never starts it.
GAZED_PING="/usr/bin/busctl --timeout=10 call com.gundulabs.Gaze /com/gundulabs/Gaze org.freedesktop.DBus.Peer Ping"
ON_DEMAND_PAM_LINES="-auth      requisite    pam_faillock.so preauth
auth       sufficient   pam_unix.so try_first_pass likeauth
auth       optional     pam_exec.so quiet $GAZED_PING
auth       sufficient   pam_gaze.so"
GAZED_START_SECONDS=120

NPU_WHEEL_URL=https://files.pythonhosted.org/packages/08/07/f225999919f56506b603aaa3ff837ad563ab26f86906ed7fa7e5abcd849e/onnxruntime_openvino-1.24.1-cp313-cp313-manylinux_2_28_x86_64.whl
NPU_WHEEL_SHA256=2c3bb73e68ac27f4891af8a595c1faf574ec68b772e6583c90a0b997a1822782
NPU_RUNTIME_DIR=/opt/onnxruntime-openvino
GAZE_OPENVINO_DIR=/usr/lib/gaze/runtimes/openvino
GAZED_DROPIN_DIR=/etc/systemd/system/gazed.service.d
NPU_CACHE_DROPIN=$GAZED_DROPIN_DIR/npu-cache.conf
ON_DEMAND_DROPIN=$GAZED_DROPIN_DIR/on-demand.conf

# Prints the whole number of seconds typed, or the default on an empty answer.
ask_seconds() {
	local question=$1 default=$2 answer
	while true; do
		read -r -p "$question [$default] " answer </dev/tty
		answer=${answer:-$default}
		[[ $answer =~ ^[0-9]+$ ]] && break
		echo "   Type a number of seconds" >/dev/tty
	done
	echo "$answer"
}

ask() {
	local answer
	read -r -p "$1 [y/N] " answer </dev/tty
	[[ $answer == [yYsS]* ]]
}

# Sets a key of /etc/gaze/config.toml, also when it is still commented out. Only for keys whose
# name appears once in the file.
set_config() {
	local key=$1 value=$2
	sudo sed -i -E "0,/^#? ?$key = .*/s||$key = $value|" "$GAZE_CONFIG"
}

gazed_answers() {
	busctl --timeout=2 call com.gundulabs.Gaze /com/gundulabs/Gaze com.gundulabs.Gaze IsCameraAvailable >/dev/null 2>&1
}

wait_for_gazed() {
	local second
	for ((second = 0; second < GAZED_START_SECONDS; second++)); do
		gazed_answers && return 0
		sleep 1
	done
	return 1
}

restart_gazed() {
	sudo systemctl restart gazed
	wait_for_gazed
}

has_enrolled_face() {
	busctl call com.gundulabs.Gaze /com/gundulabs/Gaze com.gundulabs.Gaze HasEnrolledFaces s "$USER" 2>/dev/null |
		grep -q true
}

has_intel_npu() {
	local device
	for device in /sys/class/accel/accel*; do
		[[ $(basename "$(readlink -f "$device/device/driver")") == intel_vpu ]] && return 0
	done
	return 1
}

# ONNX Runtime with OpenVINO, from Intel's Python wheel: it is the only Linux build published, and
# its libraries find each other next to themselves, so Python is not needed to use them.
install_npu_runtime() {
	local wheel
	wheel=$(mktemp --suffix=.whl)
	curl -fL --progress-bar -o "$wheel" "$NPU_WHEEL_URL"
	echo "$NPU_WHEEL_SHA256  $wheel" | sha256sum -c --quiet

	local unpacked
	unpacked=$(mktemp -d)
	bsdtar -xf "$wheel" -C "$unpacked" 'onnxruntime/capi/*.so*' onnxruntime/LICENSE
	rm "$unpacked"/onnxruntime/capi/onnxruntime_pybind11_state*.so

	sudo rm -rf "$NPU_RUNTIME_DIR"
	sudo install -d "$NPU_RUNTIME_DIR/lib"
	sudo install -m 755 -t "$NPU_RUNTIME_DIR/lib" "$unpacked"/onnxruntime/capi/*
	sudo install -m 644 "$unpacked/onnxruntime/LICENSE" "$NPU_RUNTIME_DIR/LICENSE"
	sudo install -d "$GAZE_OPENVINO_DIR"
	sudo ln -sf "$(ls "$NPU_RUNTIME_DIR"/lib/libonnxruntime.so.*)" "$GAZE_OPENVINO_DIR/libonnxruntime.so"
	rm -rf "$wheel" "$unpacked"
}

write_gazed_dropin() {
	local path=$1 settings=$2
	printf '[Service]\n%s\n' "$settings" | sudo install -Dm644 /dev/stdin "$path"
	sudo systemctl daemon-reload
}

remove_gazed_dropin() {
	sudo rm -f "$1"
	sudo systemctl daemon-reload
}

remove_npu_runtime() {
	sudo rm -rf "$NPU_RUNTIME_DIR" "$GAZE_OPENVINO_DIR"
	remove_gazed_dropin "$NPU_CACHE_DROPIN"
}

# The models compiled for the NPU are kept in RAM, never on disk: there the NPU driver can hang
# pinning them. "each-start" compiles them again every time gazed starts (about 2 s); "kept" holds
# them in /run between starts (12 MB).
place_npu_cache() {
	if [[ $1 == kept ]]; then
		write_gazed_dropin "$NPU_CACHE_DROPIN" "RuntimeDirectory=gaze/npu-cache
BindPaths=/run/gaze/npu-cache:/var/cache/gaze/inference"
	else
		write_gazed_dropin "$NPU_CACHE_DROPIN" "TemporaryFileSystem=/var/cache/gaze/inference:mode=0700"
	fi
}

runs_on_npu() {
	grep -q '^device = "npu"' "$GAZE_CONFIG"
}

use_cpu() {
	set_config execution_provider '"cpu"'
	set_config device '"cpu"'
}

setup_npu() {
	has_intel_npu || return 0
	ask "== An Intel NPU is here. Run the face models on it instead of the processor (downloads 85 MB, gazed takes about 230 MB of RAM instead of 110 MB)?" || return 0

	yay -S --needed intel-npu-driver level-zero-loader
	install_npu_runtime
	place_npu_cache each-start
	set_config execution_provider '"openvino"'
	set_config device '"npu"'
	if restart_gazed; then
		echo "== Gaze runs on the NPU"
		return 0
	fi

	echo "== Gaze did not start on the NPU within ${GAZED_START_SECONDS}s: back to the processor"
	use_cpu
	remove_npu_runtime
	restart_gazed || die "gazed does not start, see journalctl -u gazed"
}

# Always running answers at once; on demand, the next request starts gazed, a little slower, and
# it exits once unused for the time chosen.
setup_start_mode() {
	if ! ask "== Start gazed only when needed (no RAM while unused, about 0.5 s more to start)?"; then
		remove_gazed_dropin "$ON_DEMAND_DROPIN"
		sudo systemctl enable gazed
		return 0
	fi

	local idle_seconds=0
	if ask "== Keep it running a while after each use, so the next one is instant?"; then
		idle_seconds=$(ask_seconds "   For how many seconds?" 300)
	fi
	write_gazed_dropin "$ON_DEMAND_DROPIN" "Environment=GAZED_IDLE_EXIT_SECONDS=$idle_seconds"
	PAM_LINES=$ON_DEMAND_PAM_LINES
	sudo systemctl disable gazed
	if runs_on_npu && ask "== Keep the NPU's compiled models in RAM while gazed is stopped (12 MB; otherwise each start takes about 1 s more)?"; then
		place_npu_cache kept
	fi
	restart_gazed || die "gazed does not start, see journalctl -u gazed"
}

configure() {
	local camera=$1
	set_config ir "\"$camera\""
	set_config ir_model true
	if [[ ! -e /dev/tpmrm0 ]]; then
		echo "== No TPM: the enrolled faces are kept unencrypted"
		set_config encrypt_templates false
	fi
}

build_package() {
	local build_dir
	build_dir=$(mktemp -d)
	cp "$HERE"/package/* "$build_dir"
	echo "== Building gaze-island (compiles gazed, it takes a while)"
	(cd "$build_dir" && makepkg -si --needed)
	rm -rf "$build_dir"
}

enrol() {
	wait_for_gazed || die "gazed does not answer, see journalctl -u gazed"
	if ! has_enrolled_face; then
		echo "== Look at the camera to enrol your face"
		gaze add-face default
	fi
}

is_installed() {
	local package
	for package in $GAZE_PACKAGES; do
		is_package_installed "$package" && return 0
	done
	has_pam_block gaze
}

uninstall() {
	remove_pam_blocks gaze
	sudo systemctl disable --now gazed 2>/dev/null || true
	remove_npu_runtime
	remove_gazed_dropin "$ON_DEMAND_DROPIN"
	local package
	for package in $GAZE_PACKAGES; do
		if is_package_installed "$package"; then
			sudo pacman -Rns "$package"
		fi
	done
	sudo rm -f "$PAM_OPTOUT"
}

install() {
	grep -qw avx2 /proc/cpuinfo || die "Gaze needs a processor with AVX2"

	echo "# howdy-island adds Gaze to PAM itself" | sudo install -Dm644 /dev/stdin "$PAM_OPTOUT"
	sudo pacman -S --needed v4l-utils
	build_package

	local camera=${1:-$(find_ir_camera)}
	[[ -n $camera ]] || die "no IR camera found, pass it as argument: ./install_gaze /dev/videoN"
	echo "== IR camera: $camera"
	configure "$camera"

	use_cpu
	sudo systemctl enable gazed
	echo "== Starting gazed (the first start downloads its models)"
	restart_gazed || die "gazed does not start, see journalctl -u gazed"
	setup_npu
	setup_start_mode
	add_pam_blocks gaze "$PAM_LINES"
}

[[ $EUID -ne 0 ]] || die "run it as your user, not root (yay refuses root)"

case ${1:-} in
--installed)
	is_installed
	exit
	;;
--uninstall)
	sudo -v
	uninstall
	;;
--enrol)
	enrol
	;;
*)
	sudo -v
	install "${1:-}"
	;;
esac
